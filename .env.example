# --- Application ---
APP_ENV=production
APP_URL=https://core4.test

# --- Database (HostForge injects DB_* automatically for managed MySQL)
# Do NOT override these on HostForge managed MySQL — the platform sets them.
# For external/self-hosted MySQL, fill them in here.
GSMS_DB_HOST=127.0.0.1
GSMS_DB_PORT=3306
GSMS_DB_NAME=great_solomon_ct4
GSMS_DB_USER=root
GSMS_DB_PASS=

# DATABASE_URL alternative (HostForge may inject this format):
# DATABASE_URL=mysql://user:password@host:3306/great_solomon_ct4

# --- Gemini AI ---
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# --- Gmail SMTP (OTP + Notifications) ---
GSMS_MAIL_HOST=smtp.gmail.com
GSMS_MAIL_PORT=587
GSMS_MAIL_USERNAME=governancesafety21@gmail.com
GSMS_MAIL_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
GSMS_MAIL_FROM_EMAIL=governancesafety21@gmail.com
GSMS_MAIL_FROM_NAME=Great Solomon Manpower Services Inc. Core Transaction 4
GSMS_OTP_SENDER_EMAIL=governancesafety21@gmail.com
