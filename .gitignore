# =============================================================
# .gitignore — GREAT SOLOMON MANPOWER SERVICES INC. — CT4
# =============================================================

# Environment secrets — NEVER commit real credentials
.env
.env.local
.env.*.local

# Backup files generated by editors / migrations
*.bak

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Runtime storage (logs, exports, reports)
storage/logs/
storage/exports/
storage/reports/
tmp/

# Keep the storage root tracked
!storage/.gitkeep

# Node (if ever added)
node_modules/
